{
	"name": "foocus",
	"compatibility_date": "2025-01-01",
	"compatibility_flags": ["nodejs_compat"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"kv_namespaces": [
		{
			"binding": "FOOCUS_KV",
			"id": "GANTI_DENGAN_ID_KV_KAMU"
		}
	]
}
